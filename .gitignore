kilde/dist/
.DS_Store
data/*/kilder/dbh-cache/
kilde/.env.local
kilde/dist-uten-hh/
kilde/dist-rangering/
kilde/dist-ajg/
__pycache__/
# Rådata-cache for de nye datasettene (hentes på nytt med skriptene; øyeblikksbildene i samordna-ledige beholdes)
data/nmbu/kilder/samordna-katalog/
data/nmbu/kilder/dbh905/
data/nmbu/kilder/arbeidsmarked/
data/nmbu/kilder/forskning/
data/nmbu/kilder/dbh-historikk/
data/nmbu/kilder/ssb-overgang/
data/nmbu/kilder/ssb-gjennomforing/

# Rangering: rå NVA-cache og lisensbelagte tidsskriftlister (AJG)
data/rangering/nva/
data/rangering/nva-forelopig/
# Siteringsmålet (OpenAlex): rå cache for NVA-DOI og OpenAlex-svar hentes på nytt med skriptene; README og enhetsoppsett beholdes
data/rangering/openalex/*
!data/rangering/openalex/README.md
!data/rangering/openalex/enheter-norden.json
!data/rangering/openalex/enheter-norge.json
!data/rangering/openalex/hh-internasjonalt.json
# Danske Pure-data (OAI-PMH): råsvar med personnavn og avledede artikkelfiler, hentes på nytt med skriptet
data/rangering/pure/
data/rangering/tidsskrift/ajg*.csv
!data/rangering/tidsskrift/ajg-mal.csv
data/rangering/dbh/
data/rangering/rangering-klartekst.json
# Excel-filer skal aldri inn i repoet
*.xlsx
*.xls
data/rangering/tidsskrift/abdc_page.html
data/rangering/tidsskrift/kilde/
data/rangering/kontroll/kilde/
!data/rangering/tidsskrift/ajg-anslag.csv

# AJG-oppslag fylt inn for hånd (lisensbelagt, slettes når tillatelsen går ut)
data/rangering/tidsskrift/ajg-oppslag*.xlsx
# AJG 2024 rå sidetekst fra avtalt uthenting (lisensbelagt)
data/rangering/tidsskrift/ajg-uthenting/
data/rangering/kontroll/ajg-gjennomgang/

# FS-uttrekk (interne tall fra FS-rapporter). Bare den krypterte utgaven i kilde/public/intern/ committes
data/nmbu/kilder/fs-lokalt/

# Markedet: rådata-cachen for kartleggingene i data/marked/ (~40 MB), hentes på nytt med skriptene i data/marked/*/
data/marked/*/kilder/
